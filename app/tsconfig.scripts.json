{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"],
    "outDir": ".out-scripts",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "files": [
    "scripts/try-ssh.ts",
    "scripts/try-deploy.ts",
    "scripts/seed-vps.ts",
    "scripts/reset-demo.ts",
    "scripts/try-monitor.ts",
    "src/main/raw.d.ts"
  ]
}
