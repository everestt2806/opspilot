# Copy file mau thanh .env roi chinh theo moi truong
# Co DATABASE_URL -> dung PostgreSQL; khong co -> bo nho (khong phu thuoc dich vu ngoai)
DATABASE_URL=postgres://user:pass@localhost:5432/items
PORT=3000
# Bat endpoint /debug/* de gay fault khi thi nghiem; mac dinh TAT
ENABLE_FAULT_ENDPOINTS=false
