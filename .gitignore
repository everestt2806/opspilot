# ── DỮ LIỆU NHẠY CẢM — TUYỆT ĐỐI KHÔNG COMMIT ────────────────
# SQLite của app chứa credential SSH đã mã hoá của bảng `vps`.
# Chỉ commit CSV export trong experiments/results/ (xem docs/07).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
secrets/

# ── State runtime ────────────────────────────────────────────
ml-service/state/
logs/
*.log
tmp/
.cache/

# ── Kết quả thí nghiệm: chỉ giữ CSV + metadata ───────────────
experiments/results/**/*.db
experiments/results/**/*.dump
experiments/results/**/raw/

# ── GitNexus index cục bộ cho AI agent ─────────────────────────
# Mỗi máy tự chạy `gitnexus analyze`; cấu hình chung ở .gitnexusrc
.gitnexus/

